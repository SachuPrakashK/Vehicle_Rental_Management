{
  "name": "fleetline",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently -k -n web,api \"npm:start:web\" \"npm:start:server\"",
    "start:web": "ng serve",
    "start:server": "npm --prefix server run dev",
    "start:all": "npm run start",
    "db:up": "docker compose -f server/docker-compose.yml up -d",
    "db:migrate": "npm --prefix server run db:migrate",
    "db:seed": "npm --prefix server run db:seed",
    "build:server": "node -e \"require('fs').rmSync('server/dist',{recursive:true,force:true})\" && npm --prefix server run build",
    "test:server": "npm --prefix server test",
    "build": "ng build",
    "vercel-build": "npm --prefix server ci && ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:unit": "ng test --watch=false",
    "test:e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"e2e/**/*.ts\" \"server/src/**/*.ts\" \"server/*.{json,ts}\" \"*.{json,ts,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"e2e/**/*.ts\" \"server/src/**/*.ts\" \"server/*.{json,ts}\" \"*.{json,ts,md}\""
  },
  "private": true,
  "packageManager": "npm@12.0.1",
  "dependencies": {
    "@amcharts/amcharts5": "^5.20.8",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource/poppins": "^5.3.0",
    "@vercel/blob": "^2.8.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "concurrently": "^10.0.5",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "24.x"
  }
}
