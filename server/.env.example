NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://fleetline:fleetline@127.0.0.1:5433/fleetline
DATABASE_SSL_MODE=disable
DATABASE_SSL_CA=
DATABASE_POOL_MAX=5
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=30
FRONTEND_ORIGIN=http://localhost:4200
# VERCEL_URL is injected automatically by Vercel for preview deployments.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
IMAGE_STORAGE_DRIVER=local
UPLOAD_DIRECTORY=uploads/profile-images
VEHICLE_UPLOAD_DIRECTORY=uploads/vehicle-images
IMAGE_UPLOAD_MAX_MB=5
EXPOSE_DEVELOPMENT_RESET_TOKEN=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Fleetline <no-reply@example.com>
SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password
