NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL_MODE=verify-full
DATABASE_SSL_CA=
DATABASE_POOL_MAX=5
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=30
FRONTEND_ORIGIN=https://fleetline-rental-management.vercel.app
# VERCEL_URL is injected automatically by Vercel for preview deployments.
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
IMAGE_STORAGE_DRIVER=vercel-blob
BLOB_READ_WRITE_TOKEN=
UPLOAD_DIRECTORY=uploads/profile-images
VEHICLE_UPLOAD_DIRECTORY=uploads/vehicle-images
IMAGE_UPLOAD_MAX_MB=4
EXPOSE_DEVELOPMENT_RESET_TOKEN=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Fleetline <no-reply@example.com>
